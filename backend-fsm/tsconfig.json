{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "bun"
    ],
    "baseUrl": ".",
    "paths": {
      "@core/*": [
        "src/core/*"
      ],
      "@db/*": [
        "src/db/*"
      ],
      "@ai/*": [
        "src/ai/*"
      ],
      "@security/*": [
        "src/security/*"
      ],
      "@emergency/*": [
        "src/emergency/*"
      ],
      "@types/*": [
        "src/types/*"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}